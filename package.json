{
  "name": "ren-three",
  "version": "0.1.0",
  "description": "The three.js renderer for ren-core: JSX over a three.js scene graph, with raycast events, on-demand rendering and a frame loop.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiltonlazary/ren-three.git"
  },
  "homepage": "https://github.com/wiltonlazary/ren-three#readme",
  "bugs": {
    "url": "https://github.com/wiltonlazary/ren-three/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.15"
  },
  "files": [
    "src",
    "types",
    "README.md"
  ],
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "types": "node scripts/types.mjs",
    "check": "tsc -p tsconfig.json",
    "test": "node scripts/types.mjs && tsc -p tsconfig.json && tsc -p test/types/tsconfig.json && node --import ren-core/loader --test test/*.test.js test/*.test.jsx && node --import ren-core/compiled --test test/*.test.jsx",
    "prepare": "node scripts/types.mjs",
    "prepack": "node scripts/types.mjs"
  },
  "dependencies": {
    "ren-canv": "file:../../../ren-canv/wtree/_repo_",
    "ren-core": "file:../../../ren-core/wtree/_repo_"
  },
  "peerDependencies": {
    "three": ">=0.160"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "rrx-core": "file:../../../rrx-core/wtree/_repo_",
    "ren-dom": "file:../../../ren-dom/wtree/_repo_",
    "three": "0.186.1",
    "typescript": "7.0.2"
  }
}
